{
  "default_profile": "primary",
  "profiles": {
    "primary": {
      "label": "小米 MiMo 图片理解",
      "provider": "openai_compatible",
      "base_url": "https://api.xiaomimimo.com/v1",
      "base_url_env": "MODEL_API_BASE_URL",
      "model": "mimo-v2.5",
      "model_env": "MODEL_NAME",
      "api_key_env": "MODEL_API_KEY",
      "timeout": 120,
      "max_tokens": 1024,
      "temperature": 0.1,
      "extra_body": {
        "max_completion_tokens": 1024,
        "thinking": {"type": "disabled"}
      }
    },
    "backup": {
      "label": "备用视觉模型",
      "provider": "openai_compatible",
      "base_url": "https://your-backup-provider.example/v1",
      "base_url_env": "BACKUP_MODEL_API_BASE_URL",
      "model": "your-backup-vision-model",
      "model_env": "BACKUP_MODEL_NAME",
      "api_key_env": "BACKUP_MODEL_API_KEY",
      "timeout": 120,
      "max_tokens": 512,
      "temperature": 0.1
    }
  }
}
