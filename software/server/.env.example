# 小米 MiMo 官方 API（图片理解仅支持 mimo-v2.5）
# 文档：https://mimo.mi.com/docs/zh-CN/quick-start/usage-guide/multimodal-understanding/image-understanding
MODEL_API_BASE_URL=https://api.xiaomimimo.com/v1
MODEL_NAME=mimo-v2.5
MODEL_API_KEY=replace-with-your-mimo-key
MODEL_PROFILE=primary
MODEL_API_TIMEOUT=120

# 小程序业务口令。正式部署必须设置，并与小程序设置页填写的 APP_TOKEN 一致。
APP_TOKEN=replace-with-miniprogram-token
MAX_UPLOAD_BYTES=5242880

# 可选闲聊模型。留空则闲聊仍用上面的 MiMo，但只发文字、不发图片。
CHAT_MODEL_API_BASE_URL=
CHAT_MODEL_NAME=
CHAT_MODEL_API_KEY=

# 可选备用模型
BACKUP_MODEL_API_BASE_URL=https://your-backup-provider.example/v1
BACKUP_MODEL_NAME=your-backup-vision-model
BACKUP_MODEL_API_KEY=replace-with-your-backup-secret

# 可选语音识别（小程序「语音说出需求」上传 /asr）
# 硅基流动示例：ASR_API_BASE_URL=https://api.siliconflow.cn/v1
# ASR_MODEL=FunAudioLLM/SenseVoiceSmall
ASR_API_BASE_URL=
ASR_API_KEY=
ASR_MODEL=whisper-1
MAX_ASR_BYTES=10485760
TASK_DB_PATH=task_memory.sqlite

# 可选长期记忆（记忆张量 MemOS 云端）。留空则关闭，识别照常进行，不请求外网。
MEMOS_API_KEY=
MEMOS_BASE_URL=https://memos.memtensor.cn/api/openmem/v1
