.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #111111;
}

.status-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  background: #000000;
  z-index: 10;
}

.status {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffe14d;
}

.camera {
  width: 100%;
  height: 360rpx;
  flex-shrink: 0;
  background: #000000;
  position: relative;
}

.panel {
  flex: 1;
  min-height: 0;
  padding: 20rpx 24rpx 48rpx;
  background: #161616;
  box-sizing: border-box;
}

.row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.btn {
  flex: 1;
  min-height: 96rpx;
  padding: 18rpx 12rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #111111;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary {
  background: #ffe14d;
}

.btn-stop {
  background: #ff4d4f;
  color: #ffffff;
}

.btn-secondary {
  background: #2b2b2b;
  color: #ffffff;
}

.voice-btn {
  background: #2f6fed;
  color: #ffffff;
}

.voice-btn.recording {
  background: #ff4d4f;
  color: #ffffff;
}

.voice-hover {
  opacity: 0.86;
}

.camera-off {
  position: absolute;
  width: 2px;
  height: 2px;
  opacity: 0;
  left: 0;
  top: 0;
}

.memory-line {
  display: block;
  margin: 0 0 8px;
  font-size: 30rpx;
  line-height: 1.45;
}

.memory-line.muted {
  color: #8b93a7;
}

.section-title {
  display: block;
  margin: 12rpx 0 12rpx;
  font-size: 28rpx;
  color: #cfcfcf;
}

.tasks {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.task {
  min-height: 88rpx;
  padding: 16rpx 22rpx;
  border-radius: 14rpx;
  background: #2b2b2b;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
}

.task-on {
  background: #ffe14d;
  color: #111111;
}

.question {
  width: 100%;
  min-height: 88rpx;
  margin-bottom: 16rpx;
  padding: 18rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  background: #000000;
  color: #ffffff;
  font-size: 32rpx;
}

.result {
  margin-bottom: 16rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #222222;
}

.result.risk-high {
  background: #4a1515;
}

.result.risk-medium {
  background: #3a2a12;
}

.result-speech {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.4;
}

.result-grid {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 16rpx;
  font-size: 30rpx;
  color: #f2f2f2;
}

.result-empty,
.safety {
  display: block;
  font-size: 28rpx;
  color: #d0d0d0;
  line-height: 1.5;
}

.debug {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 16rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #000000;
  color: #9aa0a6;
  font-size: 24rpx;
  word-break: break-all;
}

.sr-live {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  border: 0;
}

.safety {
  margin-top: 8rpx;
}
