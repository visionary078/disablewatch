<view class="page">
  <view
    class="status"
    aria-role="text"
    aria-live="polite"
    aria-atomic="true"
    aria-label="{{statusLabel}}"
    bindlongpress="onOpenSettings"
  >
    {{statusText}}
  </view>

  <camera
    class="camera camera-off"
    device-position="back"
    flash="off"
    resolution="medium"
    frame-size="medium"
    bindinitdone="onCameraInit"
    binderror="onCameraError"
    bindstop="onCameraStop"
    aria-hidden="true"
  ></camera>

  <view
    class="btn voice-btn {{recording ? 'recording' : ''}}"
    aria-role="button"
    aria-label="{{voiceAria}}"
    aria-pressed="{{recording}}"
    hover-class="voice-hover"
    hover-stay-time="80"
    catchtouchstart="onVoicePress"
    catchtouchend="onVoiceRelease"
    catchtouchcancel="onVoiceRelease"
  >
    {{voiceLabel}}
  </view>

  <text class="result-speech" aria-live="assertive">{{resultSpeech}}</text>
  <text class="memory-line">正在找：{{memoryNow}}</text>

  <text class="safety" aria-role="text">手杖照常用。过马路别靠我。</text>
</view>
